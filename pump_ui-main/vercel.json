{
    "version": 2,
    "builds": [
        {
            "src": "angular.json",
            "use": "@vercel/angular"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "https://your-spring-api-domain.com/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}